# IP Optics calculation — generated by QMatSuite
#
optics                           # [R] Linear Response optical properties
chi                              # [R][X] IP Response function
dipoles                          # [R] Oscillator strengths
Chimod= "IP"                    # [X] IP/Hartree/ALDA/LRC
% ChiEnRnge
  0.00000 | 10.00000 |         eV    # [X] Energy range
%
% ChiDmRnge
 0.100000 | 0.100000 |         eV    # [X] Damping range
%
ChiEnStps= 200                 # [X] Energy steps
% BndsRnXd
   1 |  50 |                         # [X] Bands range
%
NGsBlkXd= 1                 RL    # [X] Response block size
% LongDrXd
 1.000000 | 0.000000 | 0.000000 |        # [X] [cc] Electric Field
%
