# BSE calculation — generated by QMatSuite
#
optics                           # [R] Linear Response optical properties
bss                              # [R] BSE solver
bse                              # [R][BSE] Bethe Salpeter Equation
em1s                             # [R][Xs] Static Screening
dipoles                          # [R] Oscillator strengths
BSKmod= "SEX"                    # [BSE] Kernel approximation
BSEmod= "resonant"               # [BSE] resonant/coupling
BSSmod= "h"                      # [BSS] Solver
Chimod= "HARTREE"                # [X] Screening approximation
% BndsRnXs
   1 |  20 |                         # [Xs] Polarization function bands
%
NGsBlkXs= 1                 RL    # [Xs] Response block size
% LongDrXs
 1.000000 | 0.000000 | 0.000000 |        # [Xs] [cc] Electric Field
%
BSENGexx=    839            RL    # [BSK] Exchange components
BSENGBlk= 1                 RL    # [BSK] Screened interaction block size
% BSEQptR
 1 | 1 |                             # [BSK] Transferred momenta range
%
% BSEBands
   3 |   6 |                         # [BSK] Bands range
%
% BEnRange
  0.00000 | 10.00000 |         eV    # [BSS] Energy range
%
% BDmRange
 0.100000 | 0.100000 |         eV    # [BSS] Damping range
%
BEnSteps= 200                 # [BSS] Energy steps
% BLongDir
 1.000000 | 0.000000 | 0.000000 |        # [BSS] [cc] Electric Field direction
%
BSEprop= "abs"                   # [BSS] absorption/jdos/kerr
BSHayTrs= -0.020000               # [BSS] Haydock threshold
