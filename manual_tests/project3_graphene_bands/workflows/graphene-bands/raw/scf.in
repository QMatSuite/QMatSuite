&CONTROL
    calculation = 'scf'
    outdir = './outdir'
    prefix = 'graphene'
    pseudo_dir = '/Users/up/quantumVITAS/pseudo'
    restart_mode = 'from_scratch'
/

&SYSTEM
    ibrav = 0
    nat = 2
    ntyp = 1
    degauss = 0.0001
    ecutrho = 400.0
    ecutwfc = 40.0
    occupations = 'smearing'
    smearing = 'marzari-vanderbilt'
/

&ELECTRONS
    conv_thr = 1e-10
    mixing_beta = 0.3
/

ATOMIC_SPECIES
  C 12.0107 C.pbe-n-kjpaw_psl.1.0.0.UPF

