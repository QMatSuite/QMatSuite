{# LAMMPS NVT MD template - Auto-generated by QMatSuite #}
# === AUTO-GENERATED BY QMATSUITE ===
# Workflow: {{ step_type }}
# Ensemble: NVT

# Initialization
units {{ units }}
atom_style {{ atom_style }}
boundary p p p

# Structure
{% if restart_from %}
read_restart {{ restart_file }}
{% else %}
read_data structure.data
{% endif %}

# Force field
{{ pair_style_block }}

# Neighbor settings
neighbor 2.0 bin
neigh_modify delay 5 every 1

# Velocity initialization
velocity all create {{ temperature }} {{ velocity_seed | default(12345) }} mom yes rot yes

# Thermostat
fix thermostat all nvt temp {{ temperature }} {{ temperature }} {{ thermostat_damp | default(100.0) }}

# Output settings
thermo {{ thermo_frequency }}
thermo_style custom step time temp pe ke etotal press vol

{% if dump_trajectory %}
dump traj all custom {{ dump_frequency }} trajectory.lammpstrj id type x y z vx vy vz fx fy fz
dump_modify traj sort id
{% endif %}

restart {{ restart_frequency | default(10000) }} restart.*.bin

# Time integration
timestep {{ timestep }}
run {{ n_steps }}

# Final structure
write_data final.data
write_restart restart.final.bin

