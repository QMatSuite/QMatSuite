 &control
    calculation = 'nscf'
    restart_mode = 'from_scratch'
    prefix = 'si'
    pseudo_dir = './pseudo/'
    outdir = './'
 /
 &system
    ibrav = 2
    celldm(1) = 10.26
    nat = 2
    ntyp = 1
    ecutwfc = 30.0
    nbnd = 50
    nosym = .true.
    noinv = .true.
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Si 28.086  Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS {crystal}
Si  0.00  0.00  0.00
Si  0.25  0.25  0.25
K_POINTS {automatic}
 4 4 4  0 0 0
