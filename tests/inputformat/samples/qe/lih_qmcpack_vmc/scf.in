 &control
    calculation = 'scf'
    restart_mode = 'from_scratch'
    prefix = 'lih'
    pseudo_dir = './pseudo/'
    outdir = './'
 /
 &system
    ibrav = 1
    celldm(1) = 7.5912
    nat = 2
    ntyp = 2
    ecutwfc = 40.0
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Li 6.941  Li_ONCV_PBE_sr.upf
 H  1.008  H_ONCV_PBE_sr.upf
ATOMIC_POSITIONS {crystal}
Li  0.0  0.0  0.0
H   0.5  0.5  0.5
K_POINTS {automatic}
 4 4 4  0 0 0
