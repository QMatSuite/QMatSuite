&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  pseudo_dir = '/home/anonymous/quantumEspresso_2019/SSSP_precision_pseudos'
/

&SYSTEM
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.01
/

&ELECTRONS
  conv_thr = 1e-08
/

K_POINTS {automatic}
  10 10 10 0 0 0

