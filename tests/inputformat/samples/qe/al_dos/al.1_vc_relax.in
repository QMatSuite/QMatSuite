&CONTROL
  calculation = 'vc-relax'
  pseudo_dir = '/home/anonymous/quantumEspresso_2019/SSSP_precision_pseudos'
  etot_conv_thr = 1e-06
  forc_conv_thr = 1e-05
/

&SYSTEM
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.01
/

&ELECTRONS
  conv_thr = 1e-08
/

&CELL
  cell_dofree = 'ibrav'
/

K_POINTS {automatic}
  10 10 10 0 0 0

