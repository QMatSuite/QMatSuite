&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  pseudo_dir = '/home/anonymous/quantumEspresso_2019/SSSP_precision_pseudos'
/

&SYSTEM
  ecutwfc = 40.0
  ecutrho = 400.0
  occupations = 'smearing'
  degauss = 0.0001
  smearing = 'marzari-vanderbilt'
/

&ELECTRONS
  conv_thr = 1e-10
  mixing_beta = 0.3
/

K_POINTS {automatic}
  12 12 1 0 0 0

