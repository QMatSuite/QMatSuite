&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  pseudo_dir = '/home/anonymous/quantumEspresso_2019/SSSP_precision_pseudos'
/

&SYSTEM
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'marzari-vanderbilt'
  degauss = 0.02
  noncolin = .true.
  starting_magnetization(1) = 0.1
  angle1(1) = 90.0
  angle2(1) = 0.0
/

&ELECTRONS
  conv_thr = 1e-08
  mixing_beta = 0.3
/

K_POINTS {automatic}
  10 10 10 0 0 0

