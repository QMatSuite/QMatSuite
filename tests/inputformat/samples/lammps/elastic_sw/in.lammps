# Compute elastic constant tensor for a crystal

variable up index 1.0e-6
variable etol index 0.0
variable ftol index 1.0e-10
variable maxiter index 100
variable maxeval index 1000
variable cfac index 1.0
variable cunits string GPa
variable atomjiggle index 1.0e-5

units           metal
atom_style      atomic
boundary        p p p

lattice         diamond 5.431
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box

mass            1 28.0855

pair_style	sw
pair_coeff	* * Si.sw Si

neighbor        0.3 bin
neigh_modify    delay 10

fix 3 all box/relax aniso 0.0
minimize ${etol} ${ftol} ${maxiter} ${maxeval}

unfix 3

run 0
