<?xml version="1.0"?>
<simulation>
<project id="heg_SJ" series="0">
  <application name="qmcapp">
    Slater-Jastrow VMC for 14-electron homogeneous electron gas at rs=5.
  </application>
  <parameter name="driver_version">batch</parameter>
</project>

  <!-- Simulation cell: rs=5 for 14 electrons, periodic -->
  <qmcsystem>
  <simulationcell>
    <parameter name="rs" condition="14">5</parameter>
    <parameter name="bconds">p p p</parameter>
    <parameter name="LR_dim_cutoff">6</parameter>
  </simulationcell>
  </qmcsystem>

  <!-- 14 electrons: 7 up, 7 down -->
  <particleset name="e" random="yes">
    <group name="u" size="7">
      <parameter name="charge">-1</parameter>
    </group>
    <group name="d" size="7">
      <parameter name="charge">-1</parameter>
    </group>
  </particleset>

  <!-- Wavefunction: free-particle (plane-wave) determinant + bspline Jastrow -->
  <wavefunction name="psi0" target="e">
    <sposet_collection type="free">
      <sposet name="spo-ud" size="7"/>
    </sposet_collection>
    <determinantset>
      <slaterdeterminant>
        <determinant id="updet" sposet="spo-ud"/>
        <determinant id="dndet" sposet="spo-ud"/>
      </slaterdeterminant>
    </determinantset>
    <jastrow name="J2" type="Two-Body" function="Bspline" optimize="yes">
      <correlation speciesA="u" speciesB="u" size="5">
        <coefficients id="uu" type="Array" optimize="yes"> 1.082858193 0.6653279375 0.4358910287 0.2243616172 0.1102948764</coefficients>
      </correlation>
      <correlation speciesA="u" speciesB="d" size="5">
        <coefficients id="ud" type="Array" optimize="yes"> 1.696171854 1.047722154 0.6275148566 0.3175982878 0.1446706214</coefficients>
      </correlation>
    </jastrow>
  </wavefunction>

  <!-- Hamiltonian: electron-electron Coulomb only (jellium background implicit) -->
  <hamiltonian name="h0" type="generic" target="e">
    <pairpot name="ElecElec" type="coulomb" source="e" target="e"/>
    <estimator type="gofr" name="gr" num_bin="200" rmax="9.712825"/>
  </hamiltonian>

  <!-- VMC run -->
  <qmc method="vmc" move="pbyp">
    <parameter name="warmupsteps">200</parameter>
    <parameter name="blocks">200</parameter>
    <parameter name="steps">40</parameter>
    <parameter name="tau">5.0</parameter>
  </qmc>
</simulation>
