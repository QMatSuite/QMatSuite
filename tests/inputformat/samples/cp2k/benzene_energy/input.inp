&GLOBAL
  PROJECT benzene_energy
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE DFTD3
        &PAIR_POTENTIAL
          TYPE DFTD3
          REFERENCE_FUNCTIONAL BLYP
          R_CUTOFF 15.0
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.000000  1.396000  0.000000
      C  1.209199  0.698000  0.000000
      C  1.209199 -0.698000  0.000000
      C  0.000000 -1.396000  0.000000
      C -1.209199 -0.698000  0.000000
      C -1.209199  0.698000  0.000000
      H  0.000000  2.484000  0.000000
      H  2.150699  1.242000  0.000000
      H  2.150699 -1.242000  0.000000
      H  0.000000 -2.484000  0.000000
      H -2.150699 -1.242000  0.000000
      H -2.150699  1.242000  0.000000
    &END COORD
    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-BLYP-q4
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-BLYP-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
