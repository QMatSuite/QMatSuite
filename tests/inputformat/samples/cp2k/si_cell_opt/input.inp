&GLOBAL
  PROJECT si_cell_opt
  RUN_TYPE CELL_OPT
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
    &END MGRID
    &SCF
      MAX_SCF 100
      EPS_SCF 1.0E-6
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A  0.0000000000  2.7150000000  2.7150000000
      B  2.7150000000  0.0000000000  2.7150000000
      C  2.7150000000  2.7150000000  0.0000000000
    &END CELL
    &COORD
      SCALED .TRUE.
      Si  0.0000000000  0.0000000000  0.0000000000
      Si  0.2500000000  0.2500000000  0.2500000000
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &CELL_OPT
    MAX_ITER 50
    OPTIMIZER BFGS
    KEEP_SYMMETRY .TRUE.
    PRESSURE_TOLERANCE 100.0
  &END CELL_OPT
&END MOTION
