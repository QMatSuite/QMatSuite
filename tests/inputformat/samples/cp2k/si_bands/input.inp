&GLOBAL
  PROJECT si_bands
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
    &END MGRID
    &SCF
      MAX_SCF 100
      EPS_SCF 1.0E-6
      ADDED_MOS 10
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300.0
      &END SMEAR
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
    &END KPOINTS
    &PRINT
      &BAND_STRUCTURE
        FILE_NAME si_bands.bs
      &END BAND_STRUCTURE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A  0.0000000000  2.7150000000  2.7150000000
      B  2.7150000000  0.0000000000  2.7150000000
      C  2.7150000000  2.7150000000  0.0000000000
    &END CELL
    &COORD
      SCALED .TRUE.
      Si  0.0000000000  0.0000000000  0.0000000000
      Si  0.2500000000  0.2500000000  0.2500000000
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
