&CONTROL
    calculation = 'nscf'
    outdir = './outdir'
    prefix = 'si'
    pseudo_dir = '<HOME>/QMatSuite/pseudo'
    restart_mode = 'from_scratch'
/

&SYSTEM
    ibrav = 0
    nat = 2
    ntyp = 1
    ecutrho = 320
    ecutwfc = 40
    nbnd = 8
    occupations = 'tetrahedra'
/

&ELECTRONS
    conv_thr = 1e-08
/

ATOMIC_SPECIES
  Si 28.0855 Si.pbe-n-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS (angstrom)
  Si 0.0 0.0 0.0
  Si 1.3773039781619372 1.3773039781619374 1.3773039781619374

CELL_PARAMETERS (angstrom)
  -2.7546079563238743 0.0 2.7546079563238743
  0.0 2.7546079563238743 2.7546079563238743
  -2.7546079563238743 2.7546079563238743 0.0

K_POINTS {automatic}
  12 12 12 0 0 0
