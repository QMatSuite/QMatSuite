&control
    calculation = 'scf'
    restart_mode='from_scratch'
    prefix = 'si'
    outdir = './outdir'
/

&system
    ibrav = 2
    celldm(1) = 10.410909236
    nat = 2
    ntyp = 1
    ecutwfc = 12.0
/

&electrons
    diago_thr_init = 1e-06
    diagonalization = 'cg'
/

ATOMIC_SPECIES
  Si 28.086 Si.pz-vbc.UPF

ATOMIC_POSITIONS (alat)
  Si 0.00 0.00 0.00
  Si 0.25 0.25 0.25

K_POINTS
  2
  0.250000 0.250000 0.250000 1.00
  0.250000 0.250000 0.750000 3.00
